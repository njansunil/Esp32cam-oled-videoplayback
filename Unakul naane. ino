static const char B64[] PROGMEM =
  "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

int b64val(char c) {
  if (c >= 'A' && c <= 'Z') return c - 'A';
  if (c >= 'a' && c <= 'z') return c - 'a' + 26;
  if (c >= '0' && c <= '9') return c - '0' + 52;
  if (c == '+') return 62;
  if (c == '/') return 63;
  return -1;
}

// Decode one Base64 frame directly from PROGMEM and expand XOR+RLE
// into the 1024-byte SSD1306/Adafruit-GFX bitmap buffer.
bool decodeFrame(const char* src, uint8_t* out, const uint8_t* prev) {
  size_t len = strlen_P(src);
  size_t p = 0;
  int val = 0, valb = -8;
  uint8_t pair[2];
  int pairPos = 0;
  size_t outPos = 0;

  while (p < len) {
    char c = pgm_read_byte(src + p++);
    if (c == '=') break;
    int v = b64val(c);
    if (v < 0) continue;
    val = (val << 6) | v;
    valb += 6;
    if (valb >= 0) {
      uint8_t decoded = (uint8_t)((val >> valb) & 0xFF);
      valb -= 8;
      pair[pairPos++] = decoded;

      if (pairPos == 2) {
        uint8_t count = pair[0];
        uint8_t value = pair[1];
        if (outPos + count > 1024) return false;
        for (uint8_t k = 0; k < count; ++k) {
          out[outPos] = prev[outPos] ^ value;
          ++outPos;
        }
        pairPos = 0;
      }
    }
  }
  return outPos == 1024;
}

uint8_t frameBuf[1024];
uint8_t previousBuf[1024];

void setup() {
  Wire.begin(SDA_PIN, SCL_PIN);
  Wire.setClock(800000);

  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR)) {
    while (true) delay(1000);
  }

  display.clearDisplay();
  display.display();
  memset(previousBuf, 0, sizeof(previousBuf));
}

void loop() {
  const uint32_t frameTime = 1000000UL / VIDEO_FPS;

  for (int i = 0; i < VIDEO_FRAMES; ++i) {
    uint32_t start = micros();

    const char* src = (const char*)pgm_read_ptr(&frameData[i]);

    if (!decodeFrame(src, frameBuf, previousBuf)) {
      memset(frameBuf, 0, sizeof(frameBuf));
    }

    display.clearDisplay();
    display.drawBitmap(0, 0, frameBuf, 128, 64, SSD1306_WHITE);
    display.display();

    memcpy(previousBuf, frameBuf, sizeof(previousBuf));

    uint32_t elapsed = micros() - start;
    if (elapsed < frameTime) {
      delayMicroseconds(frameTime - elapsed);
    }
  }
}
